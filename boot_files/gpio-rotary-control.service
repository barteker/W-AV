[Unit]
Description=GPIO Rotary Controller
After=network.target

[Service]
Type=simple
User=root
Group=gpio
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/wave/W-AV/env/bin/python /home/wave/W-AV/gpio_rotary_control.py
WorkingDirectory=/home/wave/W-AV
Restart=on-failure
RestartSec=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target